{
  "name": "psycocity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run build -w @psycocity/validation && npm run db:indexes && concurrently --kill-others --names contracts,api,web,mail,payments \"npm run dev -w @psycocity/validation\" \"npm run dev -w @psycocity/api\" \"npm run dev -w @psycocity/web\" \"npm run worker:mail\" \"npm run worker:payments\"",
    "build": "npm run build -w @psycocity/validation && npm run build -w @psycocity/api && npm run build -w @psycocity/web",
    "typecheck": "npm run build -w @psycocity/validation && npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "start": "npm run start -w @psycocity/api",
    "smoke:dev": "node scripts/smoke.mjs development",
    "smoke:production": "node scripts/smoke.mjs production",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/playwright.mjs test",
    "browser:install": "node scripts/playwright.mjs install chromium",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:database && npm run build && npm run smoke:dev && npm run smoke:production && npm run test:e2e",
    "db:up": "docker compose up -d --wait mongodb",
    "db:stop": "docker compose stop mongodb",
    "db:test:up": "docker compose --profile test up -d --wait mongodb-test",
    "db:test:stop": "docker compose --profile test stop mongodb-test",
    "test:database": "vitest run --config vitest.database.config.ts",
    "db:indexes": "npm run db:indexes -w @psycocity/api",
    "worker:mail": "npm run worker:mail -w @psycocity/api",
    "mail:smoke": "npm run mail:smoke -w @psycocity/api",
    "media:cleanup": "npm run media:cleanup -w @psycocity/api",
    "admin:bootstrap": "npm run admin:bootstrap -w @psycocity/api --",
    "worker:payments": "npm run worker:payments -w @psycocity/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
