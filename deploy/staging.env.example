# Store the filled file outside Git, mode 0600. Use separate staging accounts/resources.
NODE_ENV=production
DEPLOYMENT_STAGE=staging
PORT=3001
SERVE_WEB=true
APP_ORIGIN=https://staging.example.invalid
POLICIES_APPROVED=false
MONGODB_URI=
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=
OUTBOX_ENCRYPTION_KEY=
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
# Optional: exact peer IP/CIDR list only after verifying your reverse-proxy network.
# Keep application ports inaccessible directly to clients. Blank means no trust.
TRUST_PROXY_CIDRS=
