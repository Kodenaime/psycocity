{
  "name": "@psycocity/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/validation/dist --ext ts,js,json --ignore \"**/node_modules/**\" --exec \"node --env-file-if-exists=../../.env --import tsx\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:indexes": "node --env-file-if-exists=../../.env --import tsx src/indexes.ts",
    "worker:mail": "node --env-file-if-exists=../../.env --import tsx src/mail/worker.ts",
    "mail:smoke": "node --env-file-if-exists=../../.env --import tsx src/mail/smoke.ts",
    "media:cleanup": "node --env-file-if-exists=../../.env --import tsx src/media/cleanup.ts",
    "admin:bootstrap": "node --env-file-if-exists=../../.env --import tsx src/admin/bootstrap.ts",
    "worker:payments": "node --env-file-if-exists=../../.env --import tsx src/payments/worker.ts",
    "mail:status": "node --env-file-if-exists=../../.env --import tsx src/mail/status.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@psycocity/validation": "0.0.0",
    "@react-router/express": "7.18.4",
    "cloudinary": "2.11.0",
    "cookie": "1.1.1",
    "express": "5.3.0",
    "mongoose": "9.11.4",
    "otpauth": "9.5.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "nodemon": "3.1.14",
    "tsx": "4.23.15"
  }
}
