# Copy to .env for local development. Never commit credentials.
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/psycocity?replicaSet=rs0&directConnection=true
# Production requires NODE_ENV=production and an explicit provisioned MONGODB_URI.
# The test URI is supplied via TEST_MONGODB_URI, not via this production binding.
# Optional Paystack TEST secret, supplied securely; checkout is disabled if absent.
# Live keys and production checkout are intentionally unavailable at this stage.
PAYSTACK_SECRET_KEY=

# Exact public browser origin. Use HTTPS for a real staging deployment.
APP_ORIGIN=http://localhost:5173
# Development runs Vite separately; deployment serves the compiled web app with the API.
SERVE_WEB=false
# Keep false until the agency approves real privacy/terms/refund/guardian policies.
# Local synthetic test workflows default to enabled if this setting is omitted.
# POLICIES_APPROVED=false

# Local-only development adapters. Production forbids them.
EMAIL_TRANSPORT=local
STORAGE_DRIVER=local
# Secure deployment uses EMAIL_TRANSPORT=resend and STORAGE_DRIVER=cloudinary.
RESEND_API_KEY=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Stable base64 encoding of exactly 32 random bytes; back up separately.
# Blank in local development generates an ignored .local key automatically.
OUTBOX_ENCRYPTION_KEY=
# See deploy/staging.env.example for explicit isolated production-runtime staging.
# Explicit trusted reverse-proxy peers only; local development leaves this blank.
TRUST_PROXY_CIDRS=
